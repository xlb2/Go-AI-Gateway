# ============================================================
# Go-AI-Gateway 配置模板 —— 复制本文件为 .env 后填写
# （.env 已被 .gitignore 忽略，密钥不会进 git；本模板可安全提交）
# 优先级：真实环境变量 > .env > 代码默认值
# ============================================================

# ---- 火山引擎（模型 API）----
# 你的 API Key（必填）
VOLC_ACCESS_KEY=

# 你的推理接入点 ID / 模型名（必填）
# 火山方舟控制台 → 在线推理 → 接入点 → 复制 ep-xxxxxxxx
VOLC_ENDPOINT_ID=

# 默认北京节点，一般留空（默认 https://ark.cn-beijing.volces.com/api/v3）
VOLC_BASE_URL=

# ---- 上下文预算（可选，不配就用默认值）----
# 窗口按 token 算，不按消息条数 —— 20 条"收到"和 20 条千字长文差两个数量级，
# 拿条数当尺子必然出错（该压的时候不压、不该压的时候把长内容压掉）。
#   触发线 = MODEL_CONTEXT_WINDOW × COMPACT_THRESHOLD_RATIO
#   保留线 = MODEL_CONTEXT_WINDOW × COMPACT_RETAIN_RATIO
# 模型返回的真实 usage 会自动校准估算系数（校准也会落成 usage/report 事件，可回溯）。
# MODEL_CONTEXT_WINDOW=128000
# COMPACT_THRESHOLD_RATIO=0.8
# COMPACT_RETAIN_RATIO=0.16

# ---- 模型调用重试（可选）----
# 一次 429 限流 / 上游 5xx / 连接抖动不该把整轮对话打挂 —— 这类故障绝大多数是瞬时的。
# 只重试"再试一次可能好"的错误：参数错、鉴权错、上下文超长重试一百次还是同样的错，
# 只是白等（还烧钱），所以那些会直接失败。
# 每次退避前都会落一条 llm/retry 事件（含次数/原因/退避时长），事后能回答"这轮为什么慢"。
# 预算按**轮**算（同一轮里 agent 会调很多次模型，共享一个预算）。
# RETRY_MAX_ATTEMPTS=5        # 最多重试几次（不含首次）
# RETRY_BASE_DELAY_MS=500     # 首次退避，之后翻倍（带 ±10% 抖动，防惊群）
# RETRY_MAX_DELAY_MS=10000    # 单次退避上限

# ---- 日志写入校验（可选）----
# 写入侧不变量校验：结构性非法的事件（比如 tool/result 缺 ToolCallID、
# compaction/summary 的区间反了）会在**写入时**被拒绝，而不是写进日志后
# 靠投影默默丢掉 —— 那样问题永远查不出来，你只会看到"工具结果凭空消失"。
#   strict（默认）拒绝写入 / warn 只告警仍写入 / off 跳过校验
# 需要体检存量数据：go run ./cmd/probe validate
# INVARIANTS=strict

# ---- 沙箱（可选）----
# 审批通过的动作会经沙箱执行器真实执行，回执里**始终**写明隔离等级
# （none / partial / full）和执行方式 —— 人得知道批的是"沙箱内"还是"裸跑"。
# 本项目自带的实现是 LocalExecutor（宿主机直跑，隔离等级 = none）。
# 打开下面这个开关后：沙箱给不出隔离就 **fail-closed 拒绝执行**，而不是"跑了再说"。
# 生产/敏感环境建议打开。
# REQUIRE_SANDBOX_ISOLATION=true

# ---- 开发/测试（可选）----
# 把模型指向本地假模型（scripts/fake-model.sh），跑测试不烧 token；
# 业务代码一行不用改。见 test/README.md。
# VOLC_BASE_URL=http://127.0.0.1:9099/api/v3

# ---- 数据库 ----
# docker-compose 把 MySQL 的 3306 映射到宿主 3307，本地连接必须写 3307
DB_DSN=root:123456@tcp(127.0.0.1:3307)/im_gateway_db?charset=utf8mb4&parseTime=True&loc=Local

# ---- MCP 集成（可选）----
# 配了 MCP_SERVER_COMMAND 就连接一个 stdio MCP server，把它的工具桥进 agent（mcp__server__tool 命名）
# 例子（连你 Phase13 毕业作品里的 Python MCP server）：
# MCP_SERVER_NAME=ext
# MCP_SERVER_COMMAND=python
# MCP_SERVER_ARGS=my_agent_server.py
